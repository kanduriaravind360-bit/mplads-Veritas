# Copy to .env and fill in. .env is gitignored; never commit real values.

# Required for any deployment: a long random string used to sign login tokens.
JWT_SECRET=

# Leave empty for the local SQLite file (data/app/sentinel.db), or point at Postgres:
# DATABASE_URL=postgresql+psycopg://sentinel:<password>@localhost:5432/sentinel
DATABASE_URL=

# docker-compose only.
POSTGRES_PASSWORD=

# 1 replaces MP and vendor names with stable pseudonyms and masks private names
# in descriptions. Keep it on for any screenshot, deck, demo or public link.
PRESENTATION_MODE=1

# Nightly re-score, hourly escalation and the weekly digest.
SCHEDULER_ENABLED=0

# Comma-separated origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
